# Byte-compiled / optimised files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
# A virtualenv created under any other name. `.venv/` and `venv/` cover the
# usual ones; these key on what a virtualenv contains rather than what it is
# called, because `git add -A` swallowed 1646 files of one called `pipcheck`.
**/pyvenv.cfg
**/site-packages/
env/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# uv
uv.lock

# Rendering output produced by examples and ad-hoc runs.
*.png
!docs/**/*.png
!tests/**/fixtures/**/*.png
# The integration's brand images are assets, not output. They are generated by
# tools/make_brand_icon.py, but Home Assistant loads them from the installed
# integration, so they have to be committed -- and the rule above silently
# swallowed them through two releases before anyone noticed.
!custom_components/**/brand/*.png

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
